DATABASE_URL=postgres://...
# Comma-separated hosts the sign-in page may run on.
SIWE_DOMAIN=localhost:3000
ALCHEMY_KEY=
SOUL_CONTRACT=0xf9a7E0172a31235d99e3d93Adf33B36A39279EE4
# Testnet chog-writer key. Production: Vercel Sensitive env var only, never a file.
SOUL_WRITER_KEY=
# Optional: override the Monad testnet RPC for the Soul writer.
SOUL_RPC_URL=
# Judge Mode demo Chog: the daily cron makes up its Activity (owner "demo"). Unset to turn off.
DEMO_TOKEN_ID=5
CRON_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Chat caps per day (defaults 200 / 1000). Keep the global one just under the Gemini free daily limit.
CHAT_PER_CALLER_DAILY=
CHAT_GLOBAL_DAILY=
# Focus Bets (Monad testnet)
FOCUS_POOL=
MOCK_CHOG=
# chog-settler key. Production: Vercel Sensitive env var only, never a file.
SETTLER_KEY=
# Optional: override the Monad testnet RPC for Focus Bets (e.g. local anvil).
FOCUS_RPC_URL=
NEXT_PUBLIC_FOCUS_POOL=
NEXT_PUBLIC_MOCK_CHOG=
# Free backup models, tried after Gemini (each optional). Groq: console.groq.com/keys. OpenRouter: openrouter.ai/keys (":free" models).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
